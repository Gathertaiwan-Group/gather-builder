# Supabase（server 端專用，service role，不可加 NEXT_PUBLIC_）
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 後台
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# 預覽簽章與 IP 雜湊
PREVIEW_SECRET=
# 對外網址（產生預覽連結用；沒設就用 request 的 origin）
APP_URL=http://localhost:3000
# 選填：有設才寄聯絡表單通知信
RESEND_API_KEY=
RESEND_FROM=Gather Builder <noreply@example.com>
# 只給 scripts/apply-migrations.mjs 用，不要放進 Vercel
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=ozwftlkgqmewtadypsfi
# shop：金流憑證加密金鑰（32 bytes；openssl rand -base64 32），換掉會讓既有憑證解不開
PAYMENT_ENC_KEY=
# shop：每日逾期訂單 cron 的 Bearer 金鑰（≥16 字）
CRON_SECRET=
